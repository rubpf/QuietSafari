// QuietSafari shared build settings.
//
// If Xcode says a bundle identifier is already in use, change the prefix below
// and run again. Info.plist files read these settings.

QUIETSAFARI_BUNDLE_PREFIX = com.quietsafari.macos
QUIETSAFARI_APP_BUNDLE_ID = $(QUIETSAFARI_BUNDLE_PREFIX)
QUIETSAFARI_EXTENSION_BUNDLE_ID = $(QUIETSAFARI_BUNDLE_PREFIX).extension
QUIETSAFARI_BLOCKER_BUNDLE_ID = $(QUIETSAFARI_BUNDLE_PREFIX).content-blocker
QUIETSAFARI_PRIVACY_BUNDLE_ID = $(QUIETSAFARI_BUNDLE_PREFIX).privacy
QUIETSAFARI_RUSSIAN_BUNDLE_ID = $(QUIETSAFARI_BUNDLE_PREFIX).russian

MARKETING_VERSION = 0.3.0
CURRENT_PROJECT_VERSION = 1

QUIETSAFARI_APP_ENTITLEMENTS = App/QuietSafari.entitlements
QUIETSAFARI_EXTENSION_ENTITLEMENTS = Extension/QuietSafariExtension.entitlements
QUIETSAFARI_BLOCKER_ENTITLEMENTS = ContentBlocker/QuietSafariContentBlocker.entitlements

#include? "Local.xcconfig"
